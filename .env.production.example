# ─────────────────────────────────────────────────────────────────────────────
#  PLANTILLA DE PRODUCCIÓN · POS de tienda única (Laravel 12)
#  Copia a .env en el servidor y completa los valores marcados.
#  Auditoría 2026-11-15: este archivo existe para que NINGÚN despliegue arranque
#  con la configuración de desarrollo (.env.example es solo para local).
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Repuestos de motos"
APP_ENV=production
APP_DEBUG=false              # NUNCA true en producción: expone .env, SQL y stack traces
APP_KEY=                     # php artisan key:generate (único por servidor)
APP_URL=https://misitiolibre.com
APP_LOCALE=es
APP_TIMEZONE=America/Caracas

# ── Base de la tienda ────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tienda
DB_USERNAME=postgres         # o un rol propio NO superusuario
DB_PASSWORD=
DB_SEARCH_PATH=tienda,public

# ── Sesiones / caché ─────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true   # la app servirá por HTTPS (obligatorio con dominio público)
CACHE_STORE=file
QUEUE_CONNECTION=sync
AUTH_MODEL=App\Models\Usuario

LOG_CHANNEL=stack
LOG_LEVEL=error              # en producción no se registran mensajes de depuración

# ── Tasa de cambio automática (opcional) ─────────────────────────────────────
EXCHANGERATE_API_KEY=
