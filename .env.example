APP_NAME="Repuestos de motos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_TIMEZONE=America/Caracas

# Base de datos: PostgreSQL con el esquema «tienda» (instálalo con database/sql/00_instalar.sql
# y los scripts 06…39). En producción usa .env.production.example como base del despliegue.
DB_CONNECTION=pgsql
DB_HOST=/tmp
DB_PORT=5433
DB_DATABASE=tienda
DB_USERNAME=postgres
DB_PASSWORD=
DB_SEARCH_PATH=tienda,public

# Sin tablas de Laravel: sesiones y caché en archivos.
SESSION_DRIVER=file
SESSION_LIFETIME=480
# Cookie de sesión solo por HTTPS. En local no hace falta; en producción el
# .env.production.example la trae en true (config/session.php ya la activa por
# defecto cuando APP_ENV no es local).
# SESSION_SECURE_COOKIE=true
CACHE_STORE=file
# (QUEUE_CONNECTION se documenta abajo, en la sección de la cola fiscal)
AUTH_MODEL=App\Models\Usuario

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ExchangeRate-API (tasas de cambio). Consigue tu clave en https://www.exchangerate-api.com
EXCHANGERATE_API_KEY=

# ── Base del portal SaaS (esquema portal) — solo para el despliegue multiinquilino ──
PORTAL_DB_HOST=127.0.0.1
PORTAL_DB_PORT=5432
PORTAL_DB_DATABASE=portal_saas
PORTAL_DB_USERNAME=postgres
PORTAL_DB_PASSWORD=

# ── Facturación digital: The Factory HKA Venezuela (TFHKA) ──────────────────────────
# Ambientes: demo        https://demoemisionv2.thefactoryhka.com.ve
#            producción  https://emision.thefactoryhka.com.ve
# Las credenciales de producción van SOLO aquí (y por tienda en tfhka_config, cifradas).
TFHKA_BASE_URL=https://demoemisionv2.thefactoryhka.com.ve
TFHKA_DEMO_URL=https://demoemisionv2.thefactoryhka.com.ve
TFHKA_PROD_URL=https://emision.thefactoryhka.com.ve
TFHKA_USUARIO=
TFHKA_CLAVE=
TFHKA_TIMEOUT=60
TFHKA_AUTO_EMITIR=true
TFHKA_CIIU=4663
TFHKA_MONEDA=BSD
TFHKA_GUARDAR_PDF=true

# ── Cola fiscal (App\Jobs\EmitirDocumentoFiscal) ────────────────────────────────────
# La emisión de la factura TFHKA sale del request de la venta y se encola. En
# DESARROLLO y en las pruebas Pest deja sync (corre inline, comportamiento de
# siempre). En PRODUCCIÓN debe ser «database» y correr un worker:
#
#     QUEUE_CONNECTION=database
#
# y el supervisor (systemd/supervisord) arranca el worker así:
#
#     php artisan queue:work --queue=fiscal --tries=5 --timeout=120 \
#         --max-jobs=100 --max-time=3600 --sleep=3 --stop-when-empty
#
# (importante: --tries; sin él el worker ignora el $tries del job y libera sin
# límite). Reintentos crecientes por cortes de red; cuando se agotan, la venta
# queda en ERROR visible en la pantalla de facturación y la agenda
# (fiscal:reintentar, cada 10 min) vuelve a encolarlas. La tabla la crea
# database/sql/45_cola_fiscal.sql.
QUEUE_CONNECTION=sync
# TFHKA_COLA_BACKOFF=15,60,300,900,3600
